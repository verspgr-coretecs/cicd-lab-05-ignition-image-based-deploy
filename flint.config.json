{
  "schemaVersion": "0.2",
  "project-paths": [
    "projects"
  ],
  "gateways": {
    "local": {
      "id": "local",
      "enabled": true,
      "projects": [
        "example-project"
      ],
      "host": "http://localhost",
      "port": 8088,
      "ssl": false,
      "ignoreSSLErrors": true,
      "ignitionVersion": "8.3.8",
      "modules": {
        "project-scan-endpoint": {
          "enabled": true
        }
      },
      "defaultEnvironment": "local",
      "environments": {
        "local": {
          "host": "http://localhost",
          "port": 8088,
          "ssl": false,
          "ignoreSSLErrors": true,
          "ignitionVersion": "8.3.8",
          "modules": {
            "project-scan-endpoint": {
              "enabled": true,
              "apiTokenFilePath": ".flint/tokens/local-api.json"
            }
          }
        },
        "test": {
          "host": "http://localhost",
          "port": 8089,
          "ssl": false,
          "ignoreSSLErrors": true,
          "ignitionVersion": "8.3.8",
          "modules": {
            "project-scan-endpoint": {
              "enabled": true,
              "apiTokenFilePath": ".flint/tokens/test-api.json"
            }
          }
        },
        "production": {
          "host": "http://localhost",
          "port": 8090,
          "ssl": false,
          "ignoreSSLErrors": true,
          "ignitionVersion": "8.3.8",
          "modules": {
            "project-scan-endpoint": {
              "enabled": true,
              "apiTokenFilePath": ".flint/tokens/production-api.json"
            }
          }
        }
      }
    }
  },
  "settings": {
    "showInheritedResources": true,
    "groupResourcesByType": true,
    "autoRefreshProjects": true,
    "searchHistoryLimit": 50
  }
}
